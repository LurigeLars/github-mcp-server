# Server-side upper bound for available GitHub MCP toolsets.
GITHUB_TOOLSETS=default,actions,code_security,dependabot,discussions,gists,git,labels,notifications,orgs,projects,secret_protection,security_advisories,stargazers

# Hard exclusions. Client headers cannot re-enable excluded tools.
# Keeps normal repo/issue/PR development writes, but blocks destructive/account-creating
# operations and GitHub Actions execution.
GITHUB_EXCLUDE_TOOLS=actions_run_trigger,create_repository,delete_repository,fork_repository,create_repository_ruleset,custom_properties_write

GITHUB_MCP_SERVER_NAME=github-local
GITHUB_MCP_SERVER_TITLE=GitHub Local

# Best-effort prompt-injection mitigation for untrusted repository content.
# Not an authorization boundary; enabled because these MCP clients can write to GitHub.
GITHUB_LOCKDOWN_MODE=1
